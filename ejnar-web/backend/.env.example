# Kopiér til .env og udfyld — eller sæt som rigtige miljøvariabler hos
# hosting-udbyderen (Railway/Fly/Render/…).

# Delt adgangskode — samme model som Streamlit-appen i dag. Tom = auth slået fra (kun til lokal dev).
APP_PASSWORD=

# Kræves for at AI-assistenten kan svare (Claude-kald). Uden nøgle: søgning/
# filtre/statistik virker stadig fint, men /api/ask returnerer en fejlbesked.
ANTHROPIC_API_KEY=

# Underskriver login-sessionens cookie. Sæt til en lang, tilfældig streng i produktion.
SESSION_SECRET=

# Tillader det oprindelsessted frontenden kører fra (kun relevant hvis I IKKE
# bruger next.config.ts-proxyen — med proxyen er alt same-origin og dette er ligegyldigt).
CORS_ORIGINS=http://localhost:3000

# Mappe med ejnar_*.csv(.zip) — som udgangspunkt den eksisterende Streamlit-apps datamappe.
EJNAR_DATA_DIR=../../ejnar

# Voyage-nøgle — IKKE brugt i v1 (bevidst keyword-only, se app/core/rag.py).
# Klar til fremtiden hvis semantisk søgning skal slås til senere.
VOYAGE_API_KEY=
